<Window x:Class="SQLGameClass1DDetective.IntroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="闇の情報学院" Width="780" Height="600" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="14">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="PageIndicator" DockPanel.Dock="Right" VerticalAlignment="Top"
                       Foreground="{StaticResource SubTextBrush}" FontFamily="{StaticResource MonoFont}"/>
            <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
        </DockPanel>

        <!-- 本文（ページごとに切り替え） -->
        <Grid Grid.Row="1">

            <!-- 1・2ページ目: 教官の語り -->
            <Border x:Name="StoryPage" Background="{StaticResource PanelBrush}"
                    CornerRadius="8" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="教官 ホネスト" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="StoryText" TextWrapping="Wrap" LineHeight="26" FontSize="16"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 3ページ目: 自己紹介（プレイヤーの分だけ） -->
            <ScrollViewer x:Name="IntroPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="16"
                               Text="では、自己紹介をしてもらおう。君の名前と、ひとことを教えてくれ。"/>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <TextBlock Text="あなたの名前" Style="{StaticResource SectionHeader}"/>
                            <TextBox x:Name="NameBox" MaxLength="20" FontSize="16"/>
                            <TextBlock x:Name="NameError" Visibility="Collapsed" Margin="0,6,0,0"
                                       Foreground="#FF8A80"/>

                            <TextBlock Text="ひとこと" Style="{StaticResource SectionHeader}" Margin="0,16,0,6"/>
                            <TextBox x:Name="PlayerIntroBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="80"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- フッター -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="NextButton" DockPanel.Dock="Right" Content="次へ ▶"
                    Style="{StaticResource AccentButton}" Click="NextButton_Click"/>
            <Button x:Name="BackButton" DockPanel.Dock="Right" Content="◀ 戻る" Margin="0,0,8,0"
                    Click="BackButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
