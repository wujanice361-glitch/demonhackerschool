<UserControl x:Class="SQLGameClass1DDetective.SubQuestCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">

    <Border x:Name="CardBorder" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="6" Padding="12" Margin="0,0,0,10">
        <StackPanel>
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right"
                           Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
                <TextBlock x:Name="HeaderText" Style="{StaticResource SectionHeader}" Margin="0"/>
            </DockPanel>

            <TextBlock x:Name="PromptText" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/>
            <TextBlock x:Name="RewardText" Foreground="{StaticResource AccentBrush}" FontSize="12"
                       Margin="0,6,0,0"/>

            <StackPanel x:Name="AnswerArea" Margin="0,8,0,0">
                <TextBlock x:Name="FormatText" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                <DockPanel Margin="0,4,0,0">
                    <Button x:Name="AnswerButton" DockPanel.Dock="Right" Content="答える" Margin="8,0,0,0"
                            Click="AnswerButton_Click"/>
                    <TextBox x:Name="AnswerBox" KeyDown="AnswerBox_KeyDown"/>
                </DockPanel>
            </StackPanel>

            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{StaticResource SubTextBrush}"/>
        </StackPanel>
    </Border>
</UserControl>
