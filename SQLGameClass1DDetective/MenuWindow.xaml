<Window x:Class="SQLGameClass1DDetective.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="メニュー" Width="380" Height="540" MinWidth="320" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="14">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 背景音楽 -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="背景音楽" Style="{StaticResource SectionHeader}"/>
                <Button x:Name="BgmToggle" Content="▶ 再生" Click="BgmToggle_Click"/>
                <DockPanel Margin="0,12,0,0">
                    <TextBlock Text="音量" DockPanel.Dock="Left" VerticalAlignment="Center"
                               Foreground="{StaticResource SubTextBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Width="40"
                               TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource SubTextBrush}"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.5"
                            ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ヒント -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="ヒント" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <TextBlock x:Name="HintCount" HorizontalAlignment="Right"
                               Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                </DockPanel>
                <Button x:Name="HintButton" DockPanel.Dock="Bottom" Margin="0,10,0,0"
                        Content="ヒントを見る" Click="HintButton_Click"/>
                <ListBox x:Name="HintList"
                         Background="{StaticResource EditorBrush}"
                         BorderBrush="{StaticResource LineBrush}"
                         Foreground="{StaticResource TextBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,4"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 終了 -->
        <Button Grid.Row="2" Content="ゲーム終了" Click="ExitButton_Click"/>
    </Grid>
</Window>
