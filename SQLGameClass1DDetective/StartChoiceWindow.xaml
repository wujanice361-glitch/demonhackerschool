<Window x:Class="SQLGameClass1DDetective.StartChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="闇の情報学院" Width="480" Height="300" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="14">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="前回の続きがあります" FontSize="22" FontWeight="Bold"/>

        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,14,0,0"
                   TextWrapping="Wrap" LineHeight="22"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="最初からやり直す" Click="RestartButton_Click"/>
            <Button Content="続きから始める" Style="{StaticResource AccentButton}"
                    Margin="8,0,0,0" Click="ContinueButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
