<Window x:Class="SQLGameClass1DDetective.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SQLGameClass1DDetective"
        Title="SQL捜査ワークスペース"
        Width="1280" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="14"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" MinWidth="320"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 左: 上=出題 / 下=設問・サブクエスト・メモ ================= -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="140"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="340" MinHeight="220"/>
                </Grid.RowDefinitions>

                <!-- 上: 出題 -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="DayText" Text="DAY 1"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold" FontSize="12"/>
                        <TextBlock x:Name="CaseTitle" Text="事件タイトル"
                                   FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="状況" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="SituationText" TextWrapping="Wrap" LineHeight="22"/>

                            <TextBlock Text="教官からの命令" Style="{StaticResource SectionHeader}" Margin="0,18,0,6"/>
                            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0"
                                    Padding="12,2,0,2">
                                <TextBlock x:Name="OrderText" TextWrapping="Wrap" LineHeight="22"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              Background="{StaticResource LineBrush}"/>

                <!-- 下: 設問 / サブクエスト / メモ（タブで切り替え） -->
                <TabControl Grid.Row="2" Margin="0,6,0,0">

                    <!-- 設問 -->
                    <TabItem Header="設問">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,12,8,0">

                                <!-- 解いた設問 -->
                                <ItemsControl x:Name="AnsweredList" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Foreground="{StaticResource SubTextBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- いまの設問 -->
                                <StackPanel x:Name="QuestionPanel">
                                    <TextBlock x:Name="QuestionNumber" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock x:Name="QuestionText" TextWrapping="Wrap" LineHeight="22"/>
                                    <TextBlock x:Name="AnswerFormat" Foreground="{StaticResource SubTextBrush}"
                                               FontSize="12" Margin="0,8,0,6"/>
                                    <TextBox x:Name="AnswerBox" Height="40" KeyDown="AnswerBox_KeyDown"/>

                                    <DockPanel Margin="0,10,0,0">
                                        <Button x:Name="HintButton" DockPanel.Dock="Right" Content="ヒント"
                                                Margin="8,0,0,0" Click="HintButton_Click"/>
                                        <Button x:Name="SubmitButton" Content="答える"
                                                Style="{StaticResource AccentButton}" Click="SubmitButton_Click"/>
                                    </DockPanel>

                                    <TextBlock x:Name="HintText" Visibility="Collapsed" TextWrapping="Wrap"
                                               Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock x:Name="SubmitResult" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource SubTextBrush}"/>
                                </StackPanel>

                                <!-- 事件解決後だけ表示 -->
                                <StackPanel x:Name="ClearedPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="✔ 事件解決" Foreground="{StaticResource AccentBrush}"
                                               FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Button x:Name="NextButton" Content="次の問題へ進む ▶"
                                            Style="{StaticResource AccentButton}" Click="NextButton_Click"/>
                                    <Button x:Name="RetryButton" Content="この問題をやり直す" Margin="0,8,0,0"
                                            Click="RetryButton_Click"/>
                                    <Button x:Name="ReviewButton" Content="解説を読み返す" Margin="0,8,0,0"
                                            Click="ReviewButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- サブクエスト -->
                    <TabItem x:Name="SubQuestTab" Header="サブクエスト">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,12,8,0">
                                <TextBlock Text="任意の課題です。解かなくても、事件は解決できます。"
                                           Foreground="{StaticResource SubTextBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <StackPanel x:Name="SubQuestList"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- メモ -->
                    <TabItem Header="メモ">
                        <Grid Margin="0,12,0,0">
                            <TextBox AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Source={x:Static local:MemoStore.Instance}, Path=Text, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                      Background="{StaticResource BgBrush}"/>

        <!-- ================= 右: ツールバー + クエリのタブ（5つ） ================= -->
        <Grid Grid.Column="2" Margin="0,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="メニュー" Margin="8,0,0,0"
                        Click="MenuButton_Click"/>
                <Button DockPanel.Dock="Right" Content="メモ(別窓)" Margin="8,0,0,0"
                        Click="NotepadButton_Click"/>
                <Button x:Name="SchemaButton" DockPanel.Dock="Right" Content="テーブル構造" Margin="8,0,0,0"
                        Style="{StaticResource OutlineAccentButton}" Click="SchemaButton_Click"/>
                <TextBlock x:Name="TimerText" DockPanel.Dock="Right"
                           VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{StaticResource SubTextBrush}"
                           FontFamily="{StaticResource MonoFont}"/>
            </DockPanel>

            <Popup x:Name="SchemaTip" Grid.Row="0" PlacementTarget="{Binding ElementName=SchemaButton}"
                   Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="14,10"
                        Margin="0,6,0,0" MaxWidth="280">
                    <StackPanel>
                        <TextBlock x:Name="SchemaTipTitle" FontWeight="Bold" Foreground="#1E1F26"/>
                        <TextBlock x:Name="SchemaTipBody" TextWrapping="Wrap" Foreground="#1E1F26"
                                   Margin="0,4,0,8"/>
                        <Button Content="わかった" Click="SchemaTipClose_Click" Padding="10,3"
                                HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- クエリのタブ（コード側で5つ作る） -->
            <TabControl x:Name="QueryTabs" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
