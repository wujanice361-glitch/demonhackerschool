<Window x:Class="SQLGameClass1DDetective.SchemaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="スキーマ" Width="380" Height="520" MinWidth="300" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="14">

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="テーブルと列の一覧"
                   Style="{StaticResource SectionHeader}"/>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap"/>

        <TreeView x:Name="SchemaTree"
                  Background="{StaticResource EditorBrush}"
                  BorderBrush="{StaticResource LineBrush}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Columns}">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <HierarchicalDataTemplate.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="{Binding DataType}" Margin="10,0,0,0"
                                           Foreground="{StaticResource SubTextBrush}"
                                           FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                        </DataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</Window>
