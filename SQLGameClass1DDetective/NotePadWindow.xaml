<Window x:Class="SQLGameClass1DDetective.NotepadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SQLGameClass1DDetective"
        Title="メモ帳" Width="420" Height="480" MinWidth="280" MinHeight="240"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="14">

    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock Text="捜査メモ" Style="{StaticResource SectionHeader}"
                       DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0"/>
            <Button Content="全消去" DockPanel.Dock="Right" Padding="10,3"
                    Click="ClearButton_Click"/>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   Text="メイン画面の「メモ」タブと同じ内容です。自動で保存されます。"
                   Foreground="{StaticResource SubTextBrush}" FontSize="12"/>

        <TextBox AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontSize="15"
                 Text="{Binding Source={x:Static local:MemoStore.Instance}, Path=Text, UpdateSourceTrigger=PropertyChanged}"/>
    </DockPanel>
</Window>
